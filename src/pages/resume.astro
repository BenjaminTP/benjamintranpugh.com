---
import fs from 'node:fs';
import path from 'node:path';
import Sheet from '../layouts/Sheet.astro';
import Frame from '../components/Frame.astro';
import Stamp from '../components/Stamp.astro';
import Projection from '../components/Projection.astro';

// The resume shows a live preview of public/resume.pdf. The page images are
// rendered from the PDF automatically at build time (see astro.config.mjs +
// scripts/render-resume.mjs). To update: replace public/resume.pdf and push.
const pub = path.join(process.cwd(), 'public');
const pdfExists = fs.existsSync(path.join(pub, 'resume.pdf'));
const pages = fs.existsSync(pub)
  ? fs
      .readdirSync(pub)
      .filter((f) => /^resume-page-\d+\.png$/.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
  : [];
---

<Sheet
  title="Resume | Benjamin Tran-Pugh"
  description="Resume of Benjamin Tran-Pugh, mechanical engineering student at the University of Waterloo."
>
  <main class="desk">
    <div class="rig">
      <Frame zones={6} ornaments>
        <div class="topbar">
          <a class="back" href="/">← ALL DRAWINGS</a>
          <div class="contacts">
            <a href="mailto:benjamintranpugh@gmail.com">benjamintranpugh@gmail.com</a>
            <a href="https://github.com/BenjaminTP">github.com/BenjaminTP</a>
            <a href="https://linkedin.com/in/benjamin-tran-pugh">
              linkedin.com/in/benjamin&#8209;tran&#8209;pugh
            </a>
          </div>
        </div>

        <div class="title-block">
          <div class="tb-main">
            <div class="tb-ids">
              <span class="code">BTP-000</span>
              <span class="sheet-no">DATA SHEET / {pages.length || 1} PAGE{pages.length === 1 ? '' : 'S'}</span>
            </div>
            <h1>Resume</h1>
          </div>
          <div class="tb-side">
            {
              pdfExists && (
                <a class="dl" href="/resume.pdf" download="Benjamin_Tran-Pugh_Resume.pdf">
                  <span>DOWNLOAD PDF</span>
                  <span>↓</span>
                </a>
              )
            }
          </div>
        </div>

        <div class="preview">
          {
            pages.length > 0 ? (
              pages.map((p, i) => (
                <figure class="fig page">
                  <div class="well">
                    <img
                      src={`/${p}`}
                      alt={`Benjamin Tran-Pugh resume, page ${i + 1}`}
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                    <span class="cm tl" aria-hidden="true" />
                    <span class="cm tr" aria-hidden="true" />
                    <span class="cm bl" aria-hidden="true" />
                    <span class="cm br" aria-hidden="true" />
                  </div>
                  <figcaption>
                    RESUME / PAGE {String(i + 1).padStart(2, '0')} OF{' '}
                    {String(pages.length).padStart(2, '0')}
                  </figcaption>
                </figure>
              ))
            ) : (
              <p class="pending">RESUME PENDING: drop resume.pdf into public/</p>
            )
          }
        </div>

        <div class="foot">
          <div class="foot-by">
            <div class="mono">DRAWN BY</div>
            <div class="by-row"><span class="name">Benjamin Tran-Pugh</span></div>
            <div class="tol">
              DIMENSIONS IN MM / TOLERANCES ±0.5 UNLESS NOTED / DO NOT SCALE DRAWING
            </div>
          </div>
          <div class="foot-proj"><Projection stacked /></div>
          <a class="foot-back" href="/">← ALL DRAWINGS</a>
          <div class="foot-stamp"><Stamp sheet="SHEET 00" small /></div>
        </div>
      </Frame>
    </div>
  </main>
</Sheet>

<style>
  .desk { min-height: 100vh; display: flex; justify-content: center; padding: 34px 20px 60px; }
  .rig { width: min(1000px, 100%); }

  .topbar {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    padding: 11px 20px; border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono); font-size: 10.5px;
  }
  .back { font-weight: 500; letter-spacing: 0.12em; }
  .back span { color: var(--label); }
  .contacts { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }

  .title-block { display: flex; border-bottom: 1px solid var(--ink); }
  .tb-main { flex: 1; padding: 22px 20px 20px; border-right: 1px solid var(--ink); }
  .tb-ids { display: flex; align-items: baseline; gap: 14px; }
  .code { font-family: var(--font-mono); font-weight: 500; font-size: 12px; letter-spacing: 0.16em; color: var(--red); }
  .sheet-no { font-family: var(--font-mono); font-weight: 500; font-size: 10px; letter-spacing: 0.14em; color: var(--label); }
  h1 { margin: 12px 0 0; font-size: 44px; line-height: 1.02; letter-spacing: -0.02em; color: var(--ink); }
  .tb-side { width: 300px; flex: none; display: flex; align-items: center; padding: 16px 20px; }
  .dl {
    flex: 1;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    border: 1.5px solid var(--ink); background: var(--fill-2); padding: 12px 14px;
    font-family: var(--font-mono); font-weight: 500; font-size: 11px; letter-spacing: 0.12em;
  }

  .preview {
    padding: 20px;
    display: flex; flex-direction: column; gap: 18px;
    border-bottom: 1px solid var(--ink);
  }
  .page .well { position: relative; }
  .page img { width: 100%; height: auto; padding: 0; background: #fff; }
  .pending {
    margin: 0;
    font-family: var(--font-mono); font-weight: 500; font-size: 10px;
    letter-spacing: 0.14em; color: var(--label);
  }
  .cm {
    position: absolute; width: 15px; height: 15px;
    background:
      linear-gradient(var(--ink), var(--ink)) center / 1.5px 100% no-repeat,
      linear-gradient(var(--ink), var(--ink)) center / 100% 1.5px no-repeat;
  }
  .cm.tl { left: 10px; top: 10px; }
  .cm.tr { right: 10px; top: 10px; }
  .cm.bl { left: 10px; bottom: 10px; }
  .cm.br { right: 10px; bottom: 10px; }

  .foot { display: flex; align-items: stretch; }
  .foot-by { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 12px 20px; border-right: 1px solid var(--frame); }
  .by-row .name { font-size: 16px; font-weight: 600; color: var(--ink); }
  .tol {
    margin-top: 3px;
    font-family: var(--font-mono); font-weight: 500; font-size: 8.5px;
    line-height: 1.5; letter-spacing: 0.1em; color: var(--label);
  }
  .foot-proj { display: flex; align-items: center; padding: 12px 16px; border-right: 1px solid var(--frame); }
  .foot-stamp { display: flex; align-items: center; padding: 12px 18px; }
  .foot-back {
    flex: none;
    display: flex;
    align-items: center;
    padding: 12px 18px;
    border-right: 1px solid var(--frame);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .desk { padding: 0; }
    .topbar { flex-direction: column; align-items: flex-start; gap: 8px; }
    .contacts { gap: 12px; font-size: 10px; }
    .title-block { flex-direction: column; }
    .tb-main { border-right: 0; border-bottom: 1px solid var(--ink); padding: 18px 16px; }
    h1 { font-size: 32px; }
    .tb-side { width: auto; padding: 14px 16px; }
    .preview { padding: 16px; }
    .foot { flex-direction: column; }
    .foot-by, .foot-proj { border-right: 0; border-bottom: 1px solid var(--frame); }
  }
</style>
