---
/**
 * Privacy-friendly YouTube embed, framed as a figure well.
 * Usage in .mdx: <YouTube id="uuaAOCRsIaw" caption="FULL DEMO" />
 */
interface Props {
  id: string;
  title?: string;
  caption?: string;
}
const { id, title = 'YouTube video', caption } = Astro.props;
---
<figure class="fig yt">
  <div class="frame">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${id}`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen></iframe>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .yt { margin: 18px 0; clear: both; }
  .frame { aspect-ratio: 16 / 9; background: var(--well); }
  iframe { width: 100%; height: 100%; display: block; border: 0; }
</style>
