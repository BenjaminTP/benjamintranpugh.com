---
/**
 * Title sheet. Covers the index until the visitor clicks or taps it, then
 * sweeps off to the left like a sheet pulled off the drawing beneath.
 *
 * There is no timer: it waits. That makes dismissing it the only way through,
 * so it must not depend on JavaScript to get out of the way. A hidden checkbox
 * does the work and the whole sheet is its <label>, so the sweep is pure CSS
 * and cannot be broken by a script failing to load. The checkbox is focusable,
 * so it is also the first thing Tab reaches and Space dismisses it.
 */
import Frame from './Frame.astro';

// Title-block values are all true. A drawing's title block is the one place a
// reader expects hard fact, so nothing here is invented (see CLAUDE.md).
const cells = [
  ['DRAWN BY', 'B. TRAN-PUGH'],
  ['DISCIPLINE', 'MECHANICAL'],
  ['INSTITUTION', 'UNIV. OF WATERLOO'],
  ['DWG NO.', 'BTP-000'],
  ['SHEET', '00 OF 08'],
  ['SCALE', 'NTS'],
  ['UNITS', 'MM'],
  ['PROJECTION', 'THIRD ANGLE'],
];
---
<input
  class="key"
  type="checkbox"
  id="splash-dismiss"
  aria-label="Dismiss the title sheet and view the drawings"
/>
<label class="splash" for="splash-dismiss">
  <div class="stage">
    <div class="sag">
      <Frame zones={4} fixed>
        <div class="plate" aria-hidden="true">
          <div class="measured">
            <h1>Benjamin Tran&#8209;Pugh</h1>
            {/* the subtitle is set as a dimension across the width of the name */}
            <div class="dim">
              <span class="ext l"></span>
              <span class="ext r"></span>
              <span class="rule"></span>
              <span class="arrow l"></span>
              <span class="arrow r"></span>
              <span class="cap">Project Portfolio</span>
            </div>
          </div>
        </div>

        <div class="tblock" aria-hidden="true">
          {
            cells.map(([k, v]) => (
              <div class="cell">
                <span class="k">{k}</span>
                <span class="v">{v}</span>
              </div>
            ))
          }
          <div class="tol">DIMENSIONS IN MM / TOLERANCES ±0.5 UNLESS NOTED / DO NOT SCALE DRAWING</div>
          <div class="hint">
            <span class="pointer">Click to continue</span>
            <span class="touch">Tap to continue</span>
          </div>
        </div>
      </Frame>
    </div>
  </div>
</label>

<style>
  /* invisible but focusable, so the sheet is keyboard-dismissable */
  .key {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    z-index: 51;
  }
  .splash {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px 20px;
    background: var(--desk);
    cursor: pointer;
    perspective: 2000px;
    perspective-origin: 50% 50%;
    /* the sheet travels well past the left edge: never let that be scrollable */
    overflow: hidden;
  }
  .stage {
    width: min(var(--sheet-w), 100% - var(--tab-w) - 12px);
    height: min(var(--sheet-h), calc(100vh - 44px));
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
  }
  /* Paper is not a rigid plane. The sheet sits in its own layer on a laggier
     curve, so it lags its own leading edge and skews into the pull instead of
     sliding like a rigid board. */
  .sag {
    height: 100%;
    transform-origin: 50% 50%;
  }
  .sag :global(.sheet) { height: 100%; display: flex; flex-direction: column; }
  .sag :global(.content) { flex: 1; min-height: 0; }

  /* ---- the sweep, on dismiss ---- */
  @keyframes splash-sweep {
    0%   { transform: translate3d(0, 0, 0) rotate(0deg); }
    14%  { transform: translate3d(1.6%, -2.4%, 72px) rotate(1.9deg); }
    100% { transform: translate3d(-136%, 10%, 0) rotate(-9deg); }
  }

  /* the sheet lagging its own leading edge, plus the shadow it picks up
     as it lifts off the stack */
  @keyframes splash-flex {
    0% {
      transform: skewY(0deg) skewX(0deg) scale(1);
      box-shadow: 0 1px 3px rgba(18, 50, 94, 0.10);
    }
    16% {
      transform: skewY(1.7deg) skewX(-1.3deg) scale(1.014);
      box-shadow: 0 20px 44px rgba(18, 50, 94, 0.30);
    }
    48% {
      transform: skewY(-2.6deg) skewX(2.8deg) scaleY(0.984);
    }
    100% {
      transform: skewY(-0.7deg) skewX(1.1deg) scale(1);
      box-shadow: 0 30px 66px rgba(18, 50, 94, 0.14);
    }
  }

  /* phone: the sheet is the whole screen, so a 9deg rotation swings the
     trailing corner back across the drawing. Shorter throw, smaller angle. */
  @keyframes splash-sweep-sm {
    0%   { transform: translate3d(0, 0, 0) rotate(0deg); }
    16%  { transform: translate3d(1.4%, -1.8%, 60px) rotate(1.4deg); }
    100% { transform: translate3d(-128%, 12%, 0) rotate(-7deg); }
  }

  .key:checked + .splash {
    pointer-events: none;
    /* the backdrop goes at once so the index is revealed by the sheet leaving,
       not by a fade. Same colour as the desk beneath, so dropping it shows
       nothing but the drawing the sheet uncovers. */
    background: transparent;
    /* no opacity change: the sheet must stay opaque the whole way out.
       visibility flips only after the motion has finished. */
    visibility: hidden;
    transition: visibility 0s linear 1400ms;
  }
  .key:checked + .splash .stage {
    animation: splash-sweep 1400ms cubic-bezier(0.36, 0, 0.15, 1) both;
  }
  .key:checked + .splash .sag {
    animation: splash-flex 1400ms cubic-bezier(0.28, 0.15, 0.25, 1) both;
  }
  @media (max-width: 768px) {
    .key:checked + .splash .stage { animation-name: splash-sweep-sm; }
  }

  @media (prefers-reduced-motion: reduce) {
    .key:checked + .splash {
      visibility: hidden;
      transition: none;
    }
    .key:checked + .splash .stage,
    .key:checked + .splash .sag { animation: none; }
  }
  /* the prompt is the affordance, so it carries the visible focus ring */
  .key:focus-visible + .splash .hint {
    outline: 2px solid var(--red);
    outline-offset: -4px;
  }

  /* ---- name and its dimension ---- */
  .plate {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .measured { display: inline-flex; flex-direction: column; }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7.4vw, 5.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .dim { position: relative; height: 40px; margin-top: 16px; }
  /* extension lines: drop from each end of the measured feature */
  .ext {
    position: absolute;
    top: -10px;
    width: 1px;
    height: 32px;
    background: var(--frame);
  }
  .ext.l { left: 0; }
  .ext.r { right: 0; }
  /* the dimension line itself */
  .rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 15px;
    height: 1px;
    background: var(--frame);
  }
  /* arrowheads, pointing outward into the extension lines */
  .arrow {
    position: absolute;
    top: 11px;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
  }
  .arrow.l { left: 0; border-right: 9px solid var(--frame); }
  .arrow.r { right: 0; border-left: 9px solid var(--frame); }
  /* the text breaks the line, the way a dimension value does */
  .cap {
    position: absolute;
    left: 50%;
    top: 6px;
    transform: translateX(-50%);
    padding: 0 14px;
    background: var(--paper);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(10px, 1.35vw, 13px);
    letter-spacing: 0.3em;
    text-indent: 0.3em; /* balance the trailing letter-space so it stays centred */
    text-transform: uppercase;
    color: var(--label);
    white-space: nowrap;
  }

  /* ---- corner title block ---- */
  .tblock {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 372px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
    background: var(--paper);
  }
  .cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 7px 10px;
    border-bottom: 1px solid var(--frame);
    border-right: 1px solid var(--frame);
    min-width: 0;
  }
  .cell:nth-child(2n) { border-right: 0; }
  .k {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 7.5px;
    letter-spacing: 0.16em;
    color: var(--label);
  }
  .v {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10.5px;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tol {
    grid-column: 1 / -1;
    padding: 5px 10px 6px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 7px;
    letter-spacing: 0.03em;
    color: var(--label);
    white-space: nowrap;
  }
  /* the only way past the sheet, so it is the loudest thing after the name */
  .hint {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 12px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    animation: hint-pulse 1.8s ease-in-out infinite;
  }
  .hint .touch { display: none; }
  /* a touch device gets "tap", a pointer gets "click": one phrase each */
  @media (hover: none) {
    .hint .pointer { display: none; }
    .hint .touch { display: inline; }
  }
  @keyframes hint-pulse {
    50% { opacity: 0.5; }
  }

  /* no pulse either, under reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hint { animation: none; }
  }

  @media (max-width: 768px) {
    .splash { padding: 0; }
    .stage { width: 100%; height: 100%; }
    /* Frame drops its fixed positioning here, so .plate has no parent height
       to fill. Let the name take the slack and the title block flow under it
       rather than float over the whole sheet. */
    .plate { padding: 20px 16px; }
    h1 { white-space: normal; font-size: clamp(2.1rem, 11.5vw, 3.4rem); }
    .measured { max-width: 100%; }
    .cap { letter-spacing: 0.22em; text-indent: 0.22em; padding: 0 9px; }
    .tblock {
      position: static;
      width: auto;
      border-left: 0;
    }
    .k { font-size: 7px; }
    .v { font-size: 9.5px; }
  }

  /* Not enough height for both: the name and the prompt win, the data goes. */
  @media (max-width: 768px) and (max-height: 720px) {
    .cell, .tol { display: none; }
  }
</style>
