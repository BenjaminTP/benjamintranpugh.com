---
/**
 * Side-by-side row of <Figure> elements; equal columns, stacks on narrow
 * screens. Defaults to 2 columns (before/after); pass cols for more.
 *
 *   <Compare cols={3}>
 *     <Figure src="slug/a.mp4" autoplay caption="A" />
 *     ...
 *   </Compare>
 */
const { cols = 2 } = Astro.props;
---
<div class="compare" style={`--cols: ${cols}`}>
  <slot />
</div>

<style>
  .compare {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1rem;
    clear: both;
    margin: 1.4rem 0;
  }
  /* the child <Figure> elements bring their own margins, so drop them here */
  .compare :global(.fig) { margin: 0; width: 100%; float: none; }
  @media (max-width: 640px) {
    .compare { grid-template-columns: 1fr; }
  }
</style>
