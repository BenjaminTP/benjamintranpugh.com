---
/**
 * A set of figures that must be read together (before/after, a run of tests).
 * The set goes full width and the prose sits below it, per the sheet spec.
 * Defaults to 2 columns; pass cols for more.
 */
const { cols = 2 } = Astro.props;
---
<div class="set" style={`--cols:${cols}`}>
  <slot />
</div>

<style>
  .set {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 14px;
    clear: both;
    margin: 18px 0;
  }
  /* children bring their own margins and floats; neutralise both here */
  .set :global(.fig) { margin: 0; width: 100%; float: none; }
  @media (max-width: 768px) {
    .set { grid-template-columns: 1fr; }
  }
</style>
