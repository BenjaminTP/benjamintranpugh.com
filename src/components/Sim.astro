---
/**
 * A self-contained interactive page from public/sims/ in a framed well,
 * with a link to open it full screen. The embedded file carries its own
 * styling, so the frame stays plain.
 */
interface Props {
  src: string;
  title: string;
  height?: string;
}
const { src, title, height = '1000px' } = Astro.props;
---
<div class="sim" style={`--h:${height}`}>
  <div class="bar">
    <span class="name">{title}</span>
    <a class="open" href={src} target="_blank" rel="noopener">OPEN FULL SCREEN ↗</a>
  </div>
  <iframe src={src} title={title} loading="lazy"></iframe>
</div>

<style>
  .sim {
    border: 1.5px solid var(--ink);
    background: var(--well);
    clear: both;
    margin: 18px 0;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    border-bottom: 1px solid var(--ink);
    background: var(--fill-1);
    padding: 9px 12px 10px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.14em;
  }
  .name { color: var(--label); }
  .open { color: var(--red); white-space: nowrap; }
  .open:hover { text-decoration: underline; }
  iframe { display: block; width: 100%; height: var(--h); border: 0; }
  @media (max-width: 768px) {
    iframe { height: 1180px; }
  }
</style>
