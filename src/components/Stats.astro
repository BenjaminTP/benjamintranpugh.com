---
/**
 * A row of measured numbers as title-block cells. Numbers only: if a figure
 * cannot be traced to a simulation or a measurement, leave it out.
 */
interface Props {
  items: { value: string; label: string }[];
  note?: string;
}
const { items, note } = Astro.props;
---
<div class="stats">
  {
    items.map((s) => (
      <div class="cell">
        <span class="v">{s.value}</span>
        <span class="l">{s.label}</span>
      </div>
    ))
  }
</div>
{note && <p class="note">{note}</p>}

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 1px;
    background: var(--frame); /* the gap becomes the hairline between cells */
    border: 1px solid var(--ink);
    clear: both;
    margin: 18px 0 0;
  }
  .cell {
    background: var(--well);
    padding: 13px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .v {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 26px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .l {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.14em;
    color: var(--label);
  }
  .note {
    margin: 8px 0 18px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 8.5px;
    line-height: 1.6;
    letter-spacing: 0.1em;
    color: var(--label);
  }
</style>
