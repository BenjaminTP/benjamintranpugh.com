---
/**
 * Click any figure well to open it full size. Styled as a detail view pulled
 * off the sheet: framed, labelled, with its caption in the bar below.
 * Delegated from [data-zoom], so any figure anywhere gets it for free.
 */
---
<dialog class="lb" aria-label="Figure detail view">
  <div class="lb-frame">
    <div class="lb-bar">
      <span class="lb-tag">DETAIL VIEW</span>
      <button class="lb-x" type="button" aria-label="Close detail view">CLOSE</button>
    </div>
    <div class="lb-stage"></div>
    <div class="lb-cap"></div>
  </div>
</dialog>

<style>
  .lb {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
  }
  .lb::backdrop { background: rgba(18, 50, 94, 0.72); }
  .lb-frame {
    position: absolute;
    inset: 3vh 3vw;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 2.5px solid var(--ink);
  }
  .lb-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--ink);
    background: var(--fill-1);
  }
  .lb-tag {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.18em;
    color: var(--label);
  }
  .lb-x {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--ink);
    padding: 6px 10px;
    cursor: pointer;
  }
  .lb-x:hover { color: var(--red); border-color: var(--red); }
  .lb-stage {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--well);
    padding: 14px;
  }
  .lb-stage :global(img),
  .lb-stage :global(video) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lb-cap {
    border-top: 1px solid var(--ink);
    background: var(--fill-1);
    padding: 9px 14px 10px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    line-height: 1.45;
    letter-spacing: 0.07em;
    color: var(--ink);
    min-height: 34px;
  }
  @media (max-width: 768px) {
    .lb-frame { inset: 0; border-width: 0; }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('.lb');
  if (dlg) {
    const stage = dlg.querySelector<HTMLElement>('.lb-stage')!;
    const cap = dlg.querySelector<HTMLElement>('.lb-cap')!;
    const VIDEO = /\.(mp4|webm|mov)$/i;

    const close = () => {
      dlg.close();
      stage.replaceChildren();
    };

    document.addEventListener('click', (e) => {
      const well = (e.target as HTMLElement)?.closest?.('[data-zoom]') as HTMLElement | null;
      if (!well) return;
      // on a phone the index cards expand their passage instead of zooming
      if (well.closest('.cell') && !window.matchMedia('(hover: hover) and (min-width: 769px)').matches)
        return;
      const src = well.dataset.zoom!;
      const el = VIDEO.test(src)
        ? Object.assign(document.createElement('video'), {
            src: `/images/${src}`,
            autoplay: true,
            loop: true,
            muted: true,
            controls: true,
            playsInline: true,
          })
        : Object.assign(document.createElement('img'), { src: `/images/${src}`, alt: well.dataset.cap ?? '' });
      stage.replaceChildren(el);
      cap.textContent = well.dataset.cap ?? '';
      dlg.showModal();
    });

    dlg.querySelector('.lb-x')!.addEventListener('click', close);
    dlg.addEventListener('close', () => stage.replaceChildren());
    // clicking the backdrop (outside the frame) closes too
    dlg.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.lb-frame')) close();
    });
  }
</script>
